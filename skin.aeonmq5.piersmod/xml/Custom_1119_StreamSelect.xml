<?xml version="1.0" encoding="UTF-8"?>
<!-- Piers 14.8.3 new dialog stream select -->
<!-- Piers 14.9.3 -->


<window id="1119" type="dialog">
    <defaultcontrol always="true">9100</defaultcontrol>
	<controls>
		<control type="group">  <!-- default group -->
			<include>Animation_DialogPopup</include>
			<control type="image">
				<left>165</left>
				<top>0</top>
				<width>45</width>
				<height>screen_height</height>
				<texture flipx="true">shadow.png</texture>
				<colordiffuse>C3FFFFFF</colordiffuse>
			</control>
			<control type="image">
				<left>1710</left>
				<top>0</top>
				<width>45</width>
				<height>screen_height</height>
				<texture>shadow.png</texture>
				<colordiffuse>C3FFFFFF</colordiffuse>
			</control>
			<control type="image">
				<left>210</left>
				<top>0</top>
				<width>1500</width>
				<height>screen_height</height>
				<texture>darkgrey.png</texture>
				<colordiffuse>$VAR[value_texturecolor]</colordiffuse>
				<include>Animation_DefaultGlass</include>
			</control>
			<control type="image">
				<left>210</left>
				<top>0</top>
				<width>1500</width>
				<height>120</height>
				<texture>black.png</texture>
				<colordiffuse>90FFFFFF</colordiffuse>
			</control>
			<control type="label">  <!-- heading -->
				<left>322</left>
				<top>8</top>
				<width>1278</width>
				<height>45</height>
				<align>center</align>
				<aligny>top</aligny>
				<label>$LOCALIZE[13392]</label>
				<font>Font_32</font>
				<textcolor>FFFFFAF0</textcolor>
			</control>
			<control type="grouplist" id="9100">
				<left>210</left>
				<top>150</top>
				<width>1500</width>
				<height>900</height>
				<itemgap>0</itemgap>
				<onleft>Dialog.Close(1119)</onleft>
				<onright>Dialog.Close(1119)</onright>
				<onup>9100</onup>
				<ondown>9100</ondown>
				<control type="button" id="11191">
					<!-- subtitle streams -->
					<label>$LOCALIZE[462]</label>
                    <label2>$VAR[ActiveVideoPlayerSubtitleLanguage]</label2>
			        <onclick>DialogSelectSubtitle</onclick>
			        <enable>VideoPlayer.HasSubtitles</enable>
				</control>
                <control type="button" id="11192">
					<!-- audio streams -->
					<label>$LOCALIZE[460]</label>
                    <label2>$VAR[ActiveVideoPlayerAudioLanguage]$VAR[AudioCodecVar, | ]$VAR[ObjectAudioTypeVar, / ]$VAR[AudioChannelsVar, ]</label2>
			        <onclick>DialogSelectAudio</onclick>
			        <enable>Integer.IsGreater(VideoPlayer.AudioStreamCount,1)</enable>
					<!-- <selected>Skin.HasSetting(viewsets_video)</selected> -->
				</control>
                <control type="button" id="11193">
					<!-- video streams -->
					<label>$LOCALIZE[38031]</label>
                    <label2>[B]$VAR[VideoCodecVar]$VAR[VideoHDRTypeVar, | ]$INFO[VideoPlayer.VideoResolution, | ]$VAR[VideoResolutionTypeVar, ][/B]</label2>
			        <onclick>DialogSelectVideo</onclick>
			        <enable>Integer.IsGreater(VideoPlayer.VideoStreamCount,1)</enable>
					<!-- <selected>Skin.HasSetting(viewsets_video)</selected> -->
				</control>
			</control>
		</control>
	</controls>
</window>
